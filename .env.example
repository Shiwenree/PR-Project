# Copy this file to .env and fill in your values: cp .env.example .env
# .env is gitignored, so your keys never get committed.

# GitHub token: github.com → Settings → Developer settings → Fine-grained tokens
# read-only access to Pull requests, Contents, and Metadata
GITHUB_TOKEN=

# Anthropic API key: console.anthropic.com → API Keys
# not needed for: python PRs.py --no-ai
AI_API_KEY=

# who to score: list your teams in teams.json (copy teams.example.json).
# optional shortcut — to score just one person without a teams.json, uncomment this:
# GITHUB_USERNAME=

# review period: the last 90 days by default. to change it, uncomment one option.
# a different number of days back from today:
# LOOKBACK_DAYS=90
# or exact dates (YYYY-MM-DD), e.g. to match a review cycle:
# START_DATE=2026-01-01
# END_DATE=2026-06-30
